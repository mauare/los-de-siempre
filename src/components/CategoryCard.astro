---
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { Category } from '../content/categories';

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<article class="group relative overflow-hidden rounded-2xl bg-ink-900 shadow-sm transition-shadow duration-300 hover:shadow-xl">
  <div class="aspect-4/5 w-full overflow-hidden">
    {category.image ? (
      <img
        src={category.image}
        alt={category.name}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
      />
    ) : (
      <ImagePlaceholder label={`Foto: ${category.name}`} class="h-full w-full" />
    )}
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 flex flex-col gap-1 p-5 transition-transform duration-300 group-hover:-translate-y-1">
    <span class="text-2xl">{category.emoji}</span>
    <h3 class="font-display text-lg font-bold text-white">{category.name}</h3>
    <p class="text-sm text-ink-200 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
      {category.description}
    </p>
  </div>
</article>
