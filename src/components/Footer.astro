---
import { site } from '../content/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800 bg-ink-950 text-ink-300">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-4 lg:px-8">
    <div>
      <p class="font-display text-2xl font-black text-white">
        <span class="text-brand-500">{site.shortName}</span> {site.name}
      </p>
      <p class="mt-3 max-w-xs text-sm text-ink-400">{site.description}</p>
      <div class="mt-5 flex gap-3">
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de Los de Siempre"
          class="flex h-10 w-10 items-center justify-center rounded-full bg-ink-900 text-ink-300 transition-colors hover:bg-brand-600 hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6 6 0 100 12 6 6 0 000-12zm0 9.837a3.837 3.837 0 110-7.674 3.837 3.837 0 010 7.674zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
          </svg>
        </a>
      </div>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-white">Horarios</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {site.hours.map((h) => (
          <li class="flex justify-between gap-4">
            <span>{h.days}</span>
            <span class="text-ink-100">{h.range}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-white">Contacto</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li>{site.address.street}, {site.address.neighborhood}</li>
        <li>
          <a href={`tel:${site.phone.e164}`} class="hover:text-brand-400">{site.phone.display}</a>
        </li>
        <li>
          <a href={site.whatsapp.getLink()} target="_blank" rel="noopener noreferrer" class="hover:text-brand-400">
            WhatsApp
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-wide text-white">Delivery</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li>{site.delivery.ownRadius}</li>
        <li>{site.delivery.outsideRadius}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-900">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 py-6 text-xs text-ink-500 sm:flex-row sm:px-6 lg:px-8">
      <p>&copy; {year} {site.name}. Todos los derechos reservados.</p>
      <p>CUIT / información legal pendiente de confirmar.</p>
    </div>
  </div>
</footer>
