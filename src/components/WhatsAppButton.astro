---
import { site } from '../content/site';

interface Props {
  variant?: 'floating' | 'inline' | 'giant';
  label?: string;
  message?: string;
  class?: string;
}

const {
  variant = 'inline',
  label = 'Pedir por WhatsApp',
  message,
  class: className = '',
} = Astro.props;

const href = site.whatsapp.getLink(message);

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-transform duration-300 ease-out hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]';

const variants: Record<string, string> = {
  inline: 'bg-[#25D366] text-white px-6 py-3 text-sm shadow-lg shadow-[#128C7E]/20 hover:bg-[#1DA851]',
  giant: 'bg-[#25D366] text-white px-10 py-5 text-lg shadow-xl shadow-[#128C7E]/30 hover:bg-[#1DA851]',
  floating:
    'fixed bottom-5 right-5 z-50 h-14 w-14 bg-[#25D366] text-white shadow-xl shadow-black/30 hover:bg-[#1DA851] animate-fade-in',
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class={`${base} ${variants[variant]} ${className}`}
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
    <path d="M16.001 3C9.373 3 4 8.373 4 15c0 2.362.688 4.564 1.875 6.417L4 29l7.771-1.84A11.94 11.94 0 0016.001 27C22.629 27 28 21.627 28 15S22.629 3 16.001 3zm0 21.75a9.71 9.71 0 01-4.953-1.354l-.355-.21-4.61 1.092 1.127-4.494-.232-.368A9.706 9.706 0 016.25 15c0-5.376 4.375-9.75 9.751-9.75 5.375 0 9.749 4.374 9.749 9.75s-4.374 9.75-9.749 9.75zm5.336-7.302c-.293-.147-1.734-.856-2.003-.954-.269-.098-.465-.147-.66.147-.196.293-.758.954-.929 1.15-.171.196-.342.22-.635.073-.293-.147-1.238-.456-2.358-1.454-.872-.778-1.461-1.739-1.632-2.033-.171-.293-.018-.452.129-.598.132-.132.293-.342.44-.514.147-.171.196-.293.293-.489.098-.196.049-.367-.024-.514-.073-.147-.66-1.589-.904-2.176-.238-.571-.48-.494-.66-.503l-.562-.01c-.196 0-.514.073-.783.367-.269.293-1.026 1.002-1.026 2.443 0 1.44 1.05 2.833 1.196 3.029.147.196 2.067 3.157 5.008 4.427.7.302 1.246.482 1.672.617.702.223 1.341.191 1.846.116.563-.084 1.734-.709 1.979-1.393.244-.685.244-1.271.171-1.393-.073-.122-.269-.196-.562-.343z"></path>
  </svg>
  <span class={variant === 'floating' ? 'sr-only' : ''}>{label}</span>
</a>
