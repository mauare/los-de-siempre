---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  light?: boolean;
}

const { eyebrow, title, subtitle, align = 'center', light = false } = Astro.props;

const alignClass = align === 'center' ? 'items-center text-center mx-auto' : 'items-start text-left';
---

<div class={`flex max-w-2xl flex-col gap-3 ${alignClass}`}>
  {eyebrow && (
    <span class={`text-xs font-bold uppercase tracking-[0.2em] ${light ? 'text-brand-400' : 'text-brand-600'}`}>
      {eyebrow}
    </span>
  )}
  <h2 class={`font-display text-3xl font-black tracking-tight sm:text-4xl ${light ? 'text-white' : 'text-ink-950 dark:text-white'}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`text-base ${light ? 'text-ink-300' : 'text-ink-600 dark:text-ink-300'}`}>
      {subtitle}
    </p>
  )}
</div>
